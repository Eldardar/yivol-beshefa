DATABASE_PATH=/var/lib/yivol/yivol.sqlite
# הגדירו 1 רק כאשר reverse proxy מהימן מנקה/מוסיף X-Forwarded-For
TRUST_PROXY=0
# כתובת הבסיס הציבורית של האתר, לבניית קישורים מוחלטים (איפוס סיסמה וכו')
PUBLIC_ORIGIN=
# הגדרות SMTP לשליחת דוא״ל איפוס סיסמה
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=יבול בשפע <no-reply@example.com>
# מפתחות VAPID להתראות דחיפה (web push). ליצירה: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com
# נדרשים רק בעת npm run seed; אין ערכי ברירת מחדל
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
