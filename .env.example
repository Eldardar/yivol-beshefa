DATABASE_PATH=/var/lib/yivol/yivol.sqlite
# הגדירו 1 רק כאשר reverse proxy מהימן מנקה/מוסיף X-Forwarded-For
TRUST_PROXY=0
# כתובת הבסיס הציבורית של האתר, לבניית קישורים מוחלטים (איפוס סיסמה וכו')
PUBLIC_ORIGIN=
# הגדרות SMTP לשליחת דוא״ל איפוס סיסמה
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=יבול בשפע <no-reply@example.com>
# מפתחות VAPID להתראות דחיפה (web push). ליצירה: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com
# פרטי חיבור ל-WhatsApp Business Platform (Cloud API) של Meta לשליחת הודעות לקוטפים.
# ללא הגדרתם, ההודעות רק יודפסו ליומן השרת (מצב פיתוח).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# שם ושפת תבנית ההודעה שאושרה מראש ב-Meta (קטגוריית UTILITY), עם שני פרמטרי טקסט: כותרת ותוכן
WHATSAPP_TEMPLATE_NAME=shift_notification
WHATSAPP_TEMPLATE_LANG=he
# נדרשים רק בעת npm run seed; אין ערכי ברירת מחדל
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
